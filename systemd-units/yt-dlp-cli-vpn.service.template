[Unit]
Description=YT-DLP CLI container (VPN)
After=network-online.target openvpn-yt-dlp.service
Wants=network-online.target
After=openvpn-yt-dlp.service
Requires=openvpn-yt-dlp.service

[Service]
Type=simple
ExecStartPre=/usr/bin/podman pull ghcr.io/jim60105/yt-dlp:pot
ExecStart=/usr/bin/podman run --rm \
    --name yt-dlp-cli-vpn \
    --network=container:openvpn-yt-dlp \
    --entrypoint /bin/sh \
    -e PUID={{PUID}} \
    -e PGID={{PGID}} \
    -e TZ=Europe/Moscow \
    -v "{{PROJECT_DIR}}/yt-dlp/config:/config:rw" \
    -v "{{DOWNLOAD_DIR}}:/downloads:rw" \
    -v "{{PROJECT_DIR}}/yt-dlp/cookies:/cookies:rw" \
    -v "{{PROJECT_DIR}}/yt-dlp/archive:/archive:rw" \
    -v "{{PROJECT_DIR}}/metube/config:/metube-cookies:ro" \
    ghcr.io/jim60105/yt-dlp:pot \
    -c "yt-dlp --update-to nightly 2>/dev/null || true; cp /metube-cookies/cookies.txt /tmp/metube-cookies.txt 2>/dev/null || true; while true; do sleep 3600; done"
ExecStop=/usr/bin/podman stop yt-dlp-cli-vpn
Restart=on-failure
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=default.target
