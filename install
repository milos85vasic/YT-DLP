#!/bin/bash
#
# YT-DLP — full install entrypoint
#
# Prepares the environment (.env, directories, config), then installs and
# enables the systemd --user integration so every service is wired to
# `systemctl --user`, survives logout, and is enabled to start on boot.
#
# This is idempotent: safe to re-run on an already-installed host.
#
# Usage:
#   ./install               # interactive where needed
#   AUTO_INSTALL=1 ./install  # non-interactive (auto-accept package installs)
#
# After this completes, bring services up with: ./boot
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

log_info()    { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
log_error()   { echo -e "${RED}[ERROR]${NC} $1"; }

echo -e "${BLUE}============================================${NC}"
echo -e "${BLUE}    YT-DLP — Install${NC}"
echo -e "${BLUE}============================================${NC}"
echo ""

cd "$SCRIPT_DIR"

# =============================================================================
# Step 1: environment + container runtime + directories (idempotent)
# =============================================================================

log_info "Step 1/3: environment setup (./scripts/lifecycle/install.sh)"
echo ""

if [ ! -x "$SCRIPT_DIR/scripts/lifecycle/install.sh" ]; then
    log_error "Missing scripts/lifecycle/install.sh"
    exit 1
fi

"$SCRIPT_DIR/scripts/lifecycle/install.sh"

# =============================================================================
# Step 2: systemd --user unit install + enable (already run by step 1's
# call into scripts/setup/setup-systemd.sh, but re-assert explicitly so this
# script is the single source of truth for "is systemd wired up")
# =============================================================================

echo ""
log_info "Step 2/3: systemd --user integration (./scripts/setup/setup-systemd.sh)"
echo ""

if [ ! -x "$SCRIPT_DIR/scripts/setup/setup-systemd.sh" ]; then
    log_error "Missing scripts/setup/setup-systemd.sh"
    exit 1
fi

"$SCRIPT_DIR/scripts/setup/setup-systemd.sh"

# =============================================================================
# Step 3: reboot persistence (loginctl linger + enablement + policy audit)
# =============================================================================

echo ""
log_info "Step 3/3: reboot persistence (./scripts/lifecycle/enable-persistence.sh)"
echo ""

if [ ! -x "$SCRIPT_DIR/scripts/lifecycle/enable-persistence.sh" ]; then
    log_error "Missing scripts/lifecycle/enable-persistence.sh"
    exit 1
fi

if ! "$SCRIPT_DIR/scripts/lifecycle/enable-persistence.sh"; then
    log_warning "Persistence check reported issues (see above) — install continues, but review before relying on reboot survival"
fi

# =============================================================================
# Summary
# =============================================================================

echo ""
echo -e "${BLUE}============================================${NC}"
echo -e "${BLUE}    Install Complete ✓${NC}"
echo -e "${BLUE}============================================${NC}"
echo ""
echo -e "${CYAN}Next step:${NC} ./boot"
echo ""
log_success "Install completed successfully!"
